---
import Hook from '@/components/ui/Hook.astro'

// Icons
import WebIcon from '@/icons/Web.astro'
import ShopIcon from '@/icons/Shop.astro'
import InstagramIcon from '@/icons/Instagram.astro'
import FacebookIcon from '@/icons/Facebook.astro'
import WhatsappIcon from '@/icons/Whatsapp.astro'

interface Props {
  href: string
  title: string
  caption: string
  label: string
  icon: string
  shape?: string
  action?: string
  featured?: boolean
  index: number
}

const {
  href,
  title,
  caption,
  label,
  icon,
  shape = 'tie',
  action,
  featured = false,
  index,
} = Astro.props

// Diccionario de íconos disponibles
const icons: Record<string, any> = {
  web: WebIcon,
  shop: ShopIcon,
  instagram: InstagramIcon,
  facebook: FacebookIcon,
  whatsapp: WhatsappIcon,
}

const SelectedIcon = icons[icon] || null

// Inclinación de reposo: cada tarjeta cuelga un poco distinta
const tilts = [0, -2.2, 1.6, 1.2, -1.8]
const tilt = featured ? 0 : tilts[index % tilts.length]
const kind = featured ? 'featured' : shape
---

<li
  class:list={['hang', `hang--${kind}`]}
  style={`--tilt: ${tilt}deg; --i: ${index};`}
>
  {
    featured ? (
      <>
        <Hook side="left" />
        <Hook side="right" />
      </>
    ) : (
      <Hook />
    )
  }
  <div class="swing">
    <a
      class="tag"
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`${label} (se abre en otra pestaña)`}
    >
      {
        featured ? (
          <>
            <span class="slot slot--left" aria-hidden="true" />
            <span class="slot slot--right" aria-hidden="true" />
          </>
        ) : (
          <span class="slot" aria-hidden="true" />
        )
      }
      {
        SelectedIcon && (
          <span class="tile" aria-hidden="true">
            <SelectedIcon class="tile-icon" />
          </span>
        )
      }
      <span class="tag-text">
        <span class="tag-title">{title}</span>
        <span class="tag-caption">{caption}</span>
      </span>
      {
        action && (
          <span class="tag-action" aria-hidden="true">
            {action}
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
              <path
                d="M4 12H20M20 12L14 6M20 12L14 18"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
        )
      }
    </a>
  </div>
</li>
